@page "/"
@page "/login"

<div class="container mt-5" style="max-width: 400px;">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-4 text-center">
            <h3 class="fw-bold mb-1 text-primary">ESTRAM PDKS</h3>
            <p class="text-muted small mb-4">Sürücü Şefliği Giriş Portalı</p>

            <div class="mb-3 text-start">
                <label class="form-label fw-semibold">Sicil No / Kullanıcı Adı</label>
                <input type="text" class="form-control form-control-lg" @bind="sicilNo" placeholder="Örn: M101" />
            </div>

            <div class="mb-4 text-start">
                <label class="form-label fw-semibold">Şifre</label>
                <input type="password" class="form-control form-control-lg" @bind="sifre" placeholder="••••••••" />
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger py-2 mb-3" role="alert">
                    @errorMessage
                </div>
            }

            <button class="btn btn-primary btn-lg w-100 fw-bold rounded-3" @onclick="GirisYap">
                Giriş Yap
            </button>
        </div>
    </div>
</div>

@code {
    private string sicilNo = "";
    private string sifre = "";
    private string errorMessage = "";

    private void GirisYap()
    {
        if (string.IsNullOrWhiteSpace(sicilNo) || string.IsNullOrWhiteSpace(sifre))
        {
            errorMessage = "Lütfen tüm alanları doldurun!";
            return;
        }

        errorMessage = "";
    }
}
